# Used by scripts/start_master.cmd; direct uvicorn does not read this file.
MASTER_HOST=127.0.0.1
MASTER_PORT=8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SCHEDULER_MODE=static
WORKER_TIMEOUT=10
TIMEOUT_CHECK_INTERVAL=1
MAX_TASK_ATTEMPTS=3
METRICS_MAX_AGE=8
FAIRNESS_MAX_SKIPS=5
HISTORY_MIN_SAMPLES=3
MIN_AVAILABLE_RAM_MB=128
RAM_TARGET_MB=1024
SCHEDULER_CPU_WEIGHT=0.35
SCHEDULER_RAM_WEIGHT=0.20
SCHEDULER_AVAILABLE_WEIGHT=0.15
SCHEDULER_LOAD_WEIGHT=0.15
SCHEDULER_HISTORY_WEIGHT=0.15
